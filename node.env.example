# Copy this file to node.env on the target VPS. node.env is intentionally
# ignored by Git because deployments may add environment-specific values.

SERVER_LABEL=SG1
PANEL_DOMAIN=panel1.example.com
SUB_DOMAIN=sub1.example.com
CDN_DOMAIN=cdn1.example.com
DIRECT_DOMAIN=direct1.example.com

XUI_VERSION=v3.6.0
XUI_INSTALL_SHA256=7bb41e811f2107a3182da9090f24893d3612b5b6310194a7dd1f9965ff29e0c8
XUI_PANEL_PORT=2053
XUI_SUB_PORT=2096
XUI_WEB_BASE_PATH=panel
XUI_SUB_PATH=sub
SUB_PROFILE_FILE=/etc/bds-dpi-bypass/subscription-profiles.json

TLS_CERT_FILE=/etc/nginx/ssl/bds-node/cert.pem
TLS_KEY_FILE=/etc/nginx/ssl/bds-node/key.pem

REALITY_DEST=www.google.com:443
REALITY_SERVER_NAME=www.google.com

ENABLE_BBR=true
ENABLE_UFW=false
