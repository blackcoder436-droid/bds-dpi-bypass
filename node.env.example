# Copy this file to node.env on the target VPS. node.env is intentionally
# ignored by Git because deployments may add environment-specific values.

SERVER_LABEL=SG1
PANEL_DOMAIN=panel1.example.com
SUB_DOMAIN=sub1.example.com
CDN_DOMAIN=cdn1.example.com
DIRECT_DOMAIN=direct1.example.com

XUI_VERSION=v3.8.5
XUI_INSTALL_SHA256=4e3fe7fe00ef8e904ce6a0e9c36fd8a0c7179fe5e786f23e31801aee84c6347d
XUI_PANEL_PORT=2053
XUI_SUB_PORT=2096
XUI_WEB_BASE_PATH=panel
XUI_SUB_PATH=sub
SUB_PROFILE_FILE=/etc/bds-dpi-bypass/subscription-profiles.json

TLS_CERT_FILE=/etc/nginx/ssl/bds-node/cert.pem
TLS_KEY_FILE=/etc/nginx/ssl/bds-node/key.pem

# Temporary compatibility for Outline users. Set false to retire the final
# direct profile without changing source code.
ENABLE_OUTLINE_SHADOWSOCKS_DIRECT=true

ENABLE_BBR=true
ENABLE_UFW=false
# full: six inbounds + WARP. cdn_vless_backup: VLESS WebSocket CDN only,
# low-memory Xray policy, no direct ports, and no WARP.
DEPLOYMENT_PROFILE=full
